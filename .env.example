# Copy thành .env rồi điền. KHÔNG commit file .env!
# Cookie lấy từ F12 → Network → request bất kỳ tới chatgpt.com → header "cookie"
CHATGPT_COOKIE=

# Model mặc định và danh sách gợi ý (phân tách bằng dấu phẩy)
CHATGPT_DEFAULT_MODEL=auto
CHATGPT_MODELS=auto,gpt-4o,gpt-4o-mini,o3-mini,o4-mini

# Khóa bảo vệ proxy /v1 (để trống = không kiểm tra; nên đặt nếu mở ra ngoài localhost)
PROXY_API_KEY=

# Proxy dùng chat tạm (không lưu vào lịch sử ChatGPT): 1/0
CHATGPT_TEMPORARY_CHAT=1

CHATGPT_DB_PATH=data/chats.db
CHATGPT_MAX_RETRIES=3
CHATGPT_TIMEOUT=180
